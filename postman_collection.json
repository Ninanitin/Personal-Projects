{
  "info": {
    "name": "Discussion Forum API",
    "description": "A comprehensive RESTful API for a discussion forum system similar to Slack threads",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"displayName\": \"John Doe\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.environment.set('authToken', pm.response.json().data.token);",
                  "    pm.collectionVariables.set('authToken', pm.response.json().data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set('authToken', pm.response.json().data.token);",
                  "    pm.collectionVariables.set('authToken', pm.response.json().data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"John Updated\",\n  \"bio\": \"Updated bio information\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Topics",
      "item": [
        {
          "name": "Get All Topics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/topics?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["topics"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Create Topic",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"JavaScript Fundamentals\",\n  \"description\": \"Discussion about JavaScript basics and modern development practices\",\n  \"category\": \"academic\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/topics",
              "host": ["{{baseUrl}}"],
              "path": ["topics"]
            }
          }
        },
        {
          "name": "Get Topic by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/topics/{{topicId}}",
              "host": ["{{baseUrl}}"],
              "path": ["topics", "{{topicId}}"]
            }
          }
        },
        {
          "name": "Update Topic",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Advanced JavaScript\",\n  \"description\": \"Updated description for advanced JavaScript topics\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/topics/{{topicId}}",
              "host": ["{{baseUrl}}"],
              "path": ["topics", "{{topicId}}"]
            }
          }
        },
        {
          "name": "Get Topics by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/topics/category/academic",
              "host": ["{{baseUrl}}"],
              "path": ["topics", "category", "academic"]
            }
          }
        },
        {
          "name": "Get Trending Topics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/topics/trending/active?limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["topics", "trending", "active"],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Discussions",
      "item": [
        {
          "name": "Get All Discussions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/discussions?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["discussions"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Create Discussion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Understanding Closures in JavaScript\",\n  \"content\": \"I am learning JavaScript and having trouble understanding closures. Can someone explain how they work?\",\n  \"topic\": \"{{topicId}}\",\n  \"tags\": [\"javascript\", \"closures\", \"help\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/discussions",
              "host": ["{{baseUrl}}"],
              "path": ["discussions"]
            }
          }
        },
        {
          "name": "Get Discussion by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/discussions/{{discussionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["discussions", "{{discussionId}}"]
            }
          }
        },
        {
          "name": "Get Discussions by Topic",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/discussions/topic/{{topicId}}?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["discussions", "topic", "{{topicId}}"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Trending Discussions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/discussions/trending/liked?limit=5&timeRange=7d",
              "host": ["{{baseUrl}}"],
              "path": ["discussions", "trending", "liked"],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "timeRange",
                  "value": "7d"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Get Comments by Discussion",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/comments/discussion/{{discussionId}}?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["comments", "discussion", "{{discussionId}}"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Create Comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Great question! Closures are functions that have access to variables in their outer scope.\",\n  \"discussion\": \"{{discussionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["comments"]
            }
          }
        },
        {
          "name": "Create Thread Reply",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"To add to the previous explanation, closures are also useful for data privacy.\",\n  \"discussion\": \"{{discussionId}}\",\n  \"parentComment\": \"{{commentId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["comments"]
            }
          }
        },
        {
          "name": "Get Thread Tree",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/comments/{{commentId}}/thread-tree",
              "host": ["{{baseUrl}}"],
              "path": ["comments", "{{commentId}}", "thread-tree"]
            }
          }
        },
        {
          "name": "Get Thread Replies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/comments/{{commentId}}/replies?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["comments", "{{commentId}}", "replies"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Likes",
      "item": [
        {
          "name": "Toggle Like Discussion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"discussionId\": \"{{discussionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/likes/toggle",
              "host": ["{{baseUrl}}"],
              "path": ["likes", "toggle"]
            }
          }
        },
        {
          "name": "Toggle Like Comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commentId\": \"{{commentId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/likes/toggle",
              "host": ["{{baseUrl}}"],
              "path": ["likes", "toggle"]
            }
          }
        },
        {
          "name": "Get Like Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/likes/status?discussionId={{discussionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["likes", "status"],
              "query": [
                {
                  "key": "discussionId",
                  "value": "{{discussionId}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "Basic Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search?query=javascript&type=all&limit=10&page=1",
              "host": ["{{baseUrl}}"],
              "path": ["search"],
              "query": [
                {
                  "key": "query",
                  "value": "javascript"
                },
                {
                  "key": "type",
                  "value": "all"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Advanced Search",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"javascript closures\",\n  \"filters\": {\n    \"category\": \"academic\",\n    \"dateRange\": {\n      \"start\": \"2024-01-01\",\n      \"end\": \"2024-12-31\"\n    }\n  },\n  \"options\": {\n    \"limit\": 10\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/search/advanced",
              "host": ["{{baseUrl}}"],
              "path": ["search", "advanced"]
            }
          }
        },
        {
          "name": "Search Suggestions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search/suggestions?query=java&type=all&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["search", "suggestions"],
              "query": [
                {
                  "key": "query",
                  "value": "java"
                },
                {
                  "key": "type",
                  "value": "all"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Search by Tags",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search/tags?tags=javascript,closures&limit=10&page=1",
              "host": ["{{baseUrl}}"],
              "path": ["search", "tags"],
              "query": [
                {
                  "key": "tags",
                  "value": "javascript,closures"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Get Popular Search Terms",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search/popular?limit=10&timeRange=7d",
              "host": ["{{baseUrl}}"],
              "path": ["search", "popular"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "timeRange",
                  "value": "7d"
                }
              ]
            }
          }
        },
        {
          "name": "Get Search Statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search/stats",
              "host": ["{{baseUrl}}"],
              "path": ["search", "stats"]
            }
          }
        }
      ]
    }
  ]
} 